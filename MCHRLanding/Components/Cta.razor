@namespace MCHRLanding.Components
<section class="cta">
    <div class="container">
        <div class="cta-content">
            <h2>¿Listo para llevar tu empresa al siguiente nivel?</h2>
            <p>Agenda una reunión gratuita con nuestros consultores y descubre cómo podemos ayudarte.</p>
            <button class="btn btn-light">Agenda tu Consulta</button>
        </div>
    </div>
</section>

<style>
    .cta {
        background: linear-gradient(135deg, var(--accent-color) 0%, #fb923c 100%);
        color: var(--text-color);
        padding: 5rem 0;
        text-align: center;
        margin-top: 4rem;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .cta-content {
        max-width: 700px;
        margin: 0 auto;
    }
    .cta-content h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text-color);
    }
    .cta-content p {
        font-size: 1.125rem;
        margin-bottom: 2rem;
        opacity: 0.9;
        color: var(--text-light);
    }
    @@media (max-width: 768px) {
        .cta-content h2 { font-size: 2rem; }
    }
</style> 
@namespace MCHRLanding.Components

<section class="features">
    <div class="container">
        <div class="section-header">
            <span class="section-badge">Nuestros servicios</span>
            <h2>¿Por qué elegirnos?</h2>
            <p>Descubre cómo potenciamos tu negocio con tecnología de vanguardia.</p>
            <div class="header-decoration">
                <span></span><span></span><span></span>
            </div>
        </div>
        
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">🧠</div>
                </div>
                <div class="feature-content">
                    <h3 class="feature-title">Consultoría Especializada</h3>
                    <p class="feature-description">
                        Asesoría estratégica en transformación digital, procesos y tecnología.
                    </p>
                    <a href="#" class="feature-link">Saber más</a>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">🔒</div>
                </div>
                <div class="feature-content">
                    <h3 class="feature-title">Seguridad y Confianza</h3>
                    <p class="feature-description">
                        Soluciones robustas, seguras y alineadas a las mejores prácticas del sector.
                    </p>
                    <a href="#" class="feature-link">Saber más</a>
                </div>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">⚡</div>
                </div>
                <div class="feature-content">
                    <h3 class="feature-title">Desarrollo Ágil</h3>
                    <p class="feature-description">
                        Equipos expertos en desarrollo de software a medida, rápidos y eficientes.
                    </p>
                    <a href="#" class="feature-link">Saber más</a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary-color: #4f46e5;
        --primary-light: #6366f1;
        --primary-dark: #4338ca;
        --accent-color: #f97316;
        --text-color: #1f2937;
        --text-light: #6b7280;
        --bg-color: #ffffff;
        --bg-light: #f9fafb;
        --bg-dark: #f3f4f6;
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        --radius-sm: 0.375rem;
        --radius-md: 0.5rem;
        --radius-lg: 1rem;
        --transition: all 0.3s ease;
    }

    .features {
        background-color: var(--bg-light);
        padding: 6rem 0;
        position: relative;
        overflow: hidden;
    }

    .features::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(circle at 20% 20%, rgba(99, 102, 241, 0.03) 0%, transparent 50%),
                          radial-gradient(circle at 80% 80%, rgba(249, 115, 22, 0.03) 0%, transparent 50%);
        pointer-events: none;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 1;
    }

    .section-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 4rem;
        position: relative;
    }

    .section-badge {
        display: inline-block;
        background-color: rgba(79, 70, 229, 0.1);
        color: var(--primary-color);
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .section-header h2 {
        font-size: 2.75rem;
        font-weight: 800;
        color: var(--text-color);
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .section-header p {
        font-size: 1.125rem;
        color: var(--text-light);
        margin-bottom: 1.5rem;
    }

    .header-decoration {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }

    .header-decoration span {
        display: block;
        height: 4px;
        border-radius: 2px;
    }

    .header-decoration span:nth-child(1) {
        width: 30px;
        background-color: var(--primary-light);
    }

    .header-decoration span:nth-child(2) {
        width: 60px;
        background-color: var(--primary-color);
    }

    .header-decoration span:nth-child(3) {
        width: 30px;
        background-color: var(--primary-dark);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
        margin-bottom: 3rem;
    }

    .feature-card {
        background-color: var(--bg-color);
        border-radius: var(--radius-lg);
        padding: 0;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        position: relative;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .feature-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--primary-light), var(--primary-dark));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .feature-card:hover::after {
        transform: scaleX(1);
    }

    .feature-icon-wrapper {
        padding: 2rem 2rem 0;
    }

    .feature-icon {
        font-size: 2.5rem;
        display: inline-block;
        background-color: rgba(79, 70, 229, 0.1);
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
        transition: var(--transition);
        box-shadow: 0 10px 20px rgba(79, 70, 229, 0.1);
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
        background-color: rgba(79, 70, 229, 0.15);
    }

    .feature-content {
        padding: 1.5rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .feature-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text-color);
        position: relative;
    }

    .feature-description {
        color: var(--text-light);
        margin-bottom: 1.5rem;
        flex-grow: 1;
        line-height: 1.6;
    }

    .feature-link {
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--transition);
        margin-top: auto;
        padding: 0.5rem 0;
        position: relative;
    }

    .feature-link:hover {
        color: var(--primary-dark);
    }

    .feature-link:after {
        content: "→";
        margin-left: 0.5rem;
        transition: var(--transition);
    }

    .feature-link:hover:after {
        transform: translateX(6px);
    }

    .feature-link::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: currentColor;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    .feature-link:hover::before {
        transform: scaleX(1);
        transform-origin: left;
    }

    .features-cta {
        text-align: center;
        margin-top: 3rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.75rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
    }

    .btn-outline {
        background-color: transparent;
        color: var(--primary-color);
        border: 2px solid var(--primary-color);
    }

    .btn-outline:hover {
        background-color: var(--primary-color);
        color: white;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    @@media (max-width: 1024px) {
        .feature-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .features {
            padding: 4rem 0;
        }
        
        .section-header {
            margin-bottom: 3rem;
        }
        
        .section-header h2 {
            font-size: 2.25rem;
        }
        
        .feature-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    @@media (max-width: 480px) {
        .section-header h2 {
            font-size: 1.875rem;
        }
        
        .feature-icon {
            width: 60px;
            height: 60px;
            font-size: 2rem;
        }
        
        .feature-content {
            padding: 1.25rem 1.5rem 1.75rem;
        }
    }
</style>

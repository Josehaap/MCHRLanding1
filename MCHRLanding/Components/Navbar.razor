@namespace MCHRLanding.Components
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<nav class="navbar">
    <div class="container">
        <div class="navbar-brand">
            <span class="logo-icon">💼</span>
            <NavLink class="navbar-item logo" href="/" Match="NavLinkMatch.All">Titulo/logo</NavLink>
            <button class="mobile-toggle" @onclick="ToggleMobileMenu" aria-label="menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
        <div class="navbar-menu @(isMobileMenuOpen ? "is-active" : "")">
            <div class="navbar-start">
                <NavLink class="navbar-item" href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                <NavLink class="navbar-item" href="/services">Servicios</NavLink>
            </div>
            <div class="navbar-end">
                <div class="navbar-item">
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="about-link">Documentación blazor</a>
                </div>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool isDropdownOpen = false;
    private bool isMobileMenuOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }
}

<style>
    :root {
        --primary-color: #3a86ff;
        --primary-hover: #2563eb;
        --text-color: #1f2937;
        --text-light: #6b7280;
        --bg-color: #ffffff;
        --bg-hover: #f3f8ff;
        --shadow-color: rgba(0,0,0,0.07);
        --shadow-hover: rgba(58,134,255,0.15);
        --navbar-height: 70px;
        --transition-speed: 0.2s;
    }


    .dark-theme {
        --primary-color: #60a5fa;
        --primary-hover: #93c5fd;
        --text-color: #f3f4f6;
        --text-light: #d1d5db;
        --bg-color: #111827;
        --bg-hover: #1f2937;
        --shadow-color: rgba(0,0,0,0.3);
        --shadow-hover: rgba(96,165,250,0.2);
    }


    .navbar {
        background: var(--bg-color);
        box-shadow: 0 4px 24px var(--shadow-color), 0 1px 2px rgba(0,0,0,0.04);
        padding: 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        height: var(--navbar-height);
        transition: background var(--transition-speed), box-shadow var(--transition-speed);
        font-family: 'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 100%;
    }


    .navbar-brand {
        display: flex;
        align-items: center;
        font-weight: 700;
        margin-right: 2.5rem;
        gap: 0.5rem;
        height: 100%;
    }
    
    .logo-icon {
        font-size: 1.75rem;
        filter: drop-shadow(0 2px 4px rgba(58,134,255,0.2));
        transition: transform var(--transition-speed);
    }
    
    .navbar-brand:hover .logo-icon {
        transform: rotate(5deg) scale(1.05);
    }
    
    .logo {
        color: var(--primary-color);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
        transition: color var(--transition-speed);
    }
    
    .logo:hover {
        color: var(--primary-hover);
    }

    .navbar-menu {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    .navbar-start {
        display: flex;
        align-items: center;
        height: 100%;
        gap: 0.25rem;
    }

    .navbar-item {
        color: var(--text-color);
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: background var(--transition-speed), 
                    color var(--transition-speed), 
                    box-shadow var(--transition-speed);
        font-weight: 500;
        font-size: 0.95rem;
        border: none;
        background: none;
        outline: none;
        position: relative;
        display: flex;
        align-items: center;
        height: 40px;
    }
    
    .navbar-item:hover, .navbar-item.active {
        background: var(--bg-hover);
        color: var(--primary-color);
        box-shadow: 0 2px 8px var(--shadow-hover);
    }
    
    .navbar-item.active {
        background: none;
        color: var(--text-color);
        box-shadow: none;
    }
    
    .navbar-item.active::after {
        display: none;
    }

    .navbar-link {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-weight: 500;
        position: relative;
        color: var(--text-color);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: background var(--transition-speed), color var(--transition-speed);
        height: 40px;
    }
    
    .navbar-link:hover {
        background: var(--bg-hover);
        color: var(--primary-color);
    }
    
    .dropdown-arrow {
        font-size: 0.65em;
        transition: transform var(--transition-speed);
        display: inline-block;
        color: var(--text-light);
    }
    
    .dropdown-arrow.is-active {
        transform: rotate(180deg);
    }
    
    .has-dropdown {
        position: relative;
    }
    
    .navbar-dropdown {
        display: block;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        background: var(--bg-color);
        box-shadow: 0 4px 20px rgba(0,0,0,0.12);
        border-radius: 12px;
        padding: 0.5rem;
        margin-top: 0.5rem;
        min-width: 200px;
        right: 0;
        top: 100%;
        transform: translateY(-10px);
        transition: opacity var(--transition-speed), transform var(--transition-speed);
        z-index: 1001;
    }
    
    .navbar-dropdown.is-active {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
    
    .navbar-dropdown .navbar-item {
        display: block;
        padding: 0.6rem 1rem;
        width: 100%;
        font-size: 0.95rem;
        border-radius: 8px;
        margin: 0.2rem 0;
    }

    .theme-toggle {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
        color: white;
        padding: 0;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: transform var(--transition-speed), box-shadow var(--transition-speed);
        box-shadow: 0 2px 10px rgba(58,134,255,0.3);
    }
    
    .theme-toggle:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(58,134,255,0.4);
    }
    
    .theme-icon {
        font-size: 1.2rem;
        transition: transform var(--transition-speed);
    }
    
    .theme-toggle:active .theme-icon {
        transform: rotate(360deg);
    }

    .mobile-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 21px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        margin-left: auto;
    }
    
    .mobile-toggle span {
        display: block;
        height: 3px;
        width: 100%;
        background: var(--text-color);
        border-radius: 3px;
        transition: transform var(--transition-speed), opacity var(--transition-speed);
    }

    @@media (max-width: 900px) {
        .container {
            padding: 0 1rem;
        }
    }
    
    @@media (max-width: 768px) {
        .mobile-toggle {
            display: flex;
        }
        
        .navbar-menu {
            position: fixed;
            top: var(--navbar-height);
            left: 0;
            width: 100%;
            background: var(--bg-color);
            flex-direction: column;
            align-items: flex-start;
            padding: 1rem;
            box-shadow: 0 4px 12px var(--shadow-color);
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
            transition: transform var(--transition-speed), opacity var(--transition-speed);
            height: auto;
            max-height: calc(100vh - var(--navbar-height));
            overflow-y: auto;
        }
        
        .navbar-menu.is-active {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }
        
        .navbar-start {
            flex-direction: column;
            width: 100%;
            align-items: flex-start;
            gap: 0.5rem;
            height: auto;
        }
        
        .navbar-item, .navbar-link {
            width: 100%;
            padding: 0.75rem 1rem;
            height: auto;
        }
        
        .navbar-dropdown {
            position: static;
            box-shadow: none;
            width: 100%;
            margin-top: 0;
            padding: 0 0 0 1rem;
            transform: none;
        }
        
        .navbar-dropdown.is-active {
            transform: none;
        }
        
        .navbar-end {
            margin-top: 1rem;
            width: 100%;
            display: flex;
            justify-content: flex-end;
        }
        
        .navbar-item.active::after {
            display: none;
        }
    }

    .page, main {
        padding-top: var(--navbar-height);
        margin: 0 auto;
        max-width: 1200px;
    }

    .hero {
        width: 100%;
        max-width: 90vw;
        margin: 2rem auto;
        min-height: 400px;
        background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        box-shadow: 0 4px 20px var(--shadow-hover);
    }

    .navbar-end {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>

@page "/contacto"
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Forms


<div>
    <ImagenSlash HayButton="false" NombreImg="ContactoPrincipal.jpg" 
        Subtitulo='@($"{contenidoContacto[idiomaDetectado][0]}" )'
        Titulo='@($"{contenidoContacto[idiomaDetectado][1]}" )' />
</div>

<div class="container">
    <div class="form-box">
        <div class="image-section">
            <img src="/img/ContactoFormulario.jpg" alt="Imagen lateral">
        </div>
        <div class="form-section">
            <h2>@($"{contenidoContacto[idiomaDetectado][2]}" )</h2>
            <EditForm Model="@contactoModel" OnValidSubmit="EnviarInfo">
                <InputText style=" width: 100%;padding:1rem;margin-bottom: 1rem;background-color: #e2e2e2;border: none;border-radius: 4px;font-size: 1rem;" @bind-Value="contactoModel.Nombre" placeholder="Nombre" />
                <InputText  style=" width: 100%;padding:1rem;margin-bottom: 1rem;background-color: #e2e2e2;border: none;border-radius: 4px;font-size: 1rem;" @bind-Value="contactoModel.Email" type="email" placeholder="Email"  />
                <InputText  style=" width: 100%;padding:1rem;margin-bottom: 1rem;background-color: #e2e2e2;border: none;border-radius: 4px;font-size: 1rem;" @bind-Value="contactoModel.Asunto" placeholder="Asunto"  />
                <InputTextArea  style=" resize: none; width: 100%;padding:1rem;margin-bottom: 1rem;background-color: #e2e2e2;border: none;border-radius: 4px;font-size: 1rem;"  @bind-Value="contactoModel.Mensaje" placeholder="Mensaje"  />
                <div class="primario">
                    <InputCheckbox style=" margin-right: 0.5rem;" @bind-Value="contactoModel.AceptaPolitica" /> <p style="margin:0; padding:0;">Acepto la política de <span> privacidad</span></p>
                </div>
                <button type="submit">Enviar</button>
            </EditForm>
            <p>@Mensaje</p>
        </div> 
    </div>
</div>
<!-- Video y texto de la demo de Recursos Humanos -->
<div class="contenedor-tabla">
  <table class="tabla-video-texto">
    <tr>

      

      <!-- Columna derecha: Texto -->
      <td class="celda-texto">
        <h2 style="text-align: center; padding-bottom: 1rem;">@($"{contenidoContacto[idiomaDetectado][11]}" )</h2>
        <p style="text-align: center;">
           @($"{contenidoContacto[idiomaDetectado][12]}" )         
        </p>
      </td>
    </tr>
  </table>
</div>

 <!-- Mapa -->
<div class="map-container">
    <img src="/img/mapa-removebg-preview.png" alt="Mapa" class="map-image">

    <div class="marker madrid">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Madrid</strong><br>
                C. de los Estudios
            </div>
        </div>
    </div>

    <div class="marker malaga">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Málaga</strong><br>
                Carretera Cádiz n°89
            </div>
        </div>
    </div>

    <div class="marker larioja">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>La Rioja</strong><br>
                Av. de la Tecnología 12
            </div>
        </div>
    </div>

    <div class="marker giblatar">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Gibraltar</strong><br>
                Europa Point Rd
            </div>
        </div>
    </div>
</div>


@code {
        public static string Mensaje { get; set; }  

    private ContactFormModel contactoModel = new ContactFormModel();

    public class ContactFormModel
    {
        public string Nombre { get; set; }
        public string Email { get; set; }
        public string Asunto { get; set; }
        public string Mensaje { get; set; }
        public bool AceptaPolitica { get; set; }
    }

    private async Task EnviarInfo()
    {
        var response = await Http.PostAsJsonAsync("api/contacto", contactoModel);
        if (response.IsSuccessStatusCode)
        {
            Mensaje = "Correo enviado correctamente";
            contactoModel = new ContactFormModel(); // limpiar formulario
        }
        else
        {
            Mensaje = "Error al enviar: " + await response.Content.ReadAsStringAsync();
        }
    }
    

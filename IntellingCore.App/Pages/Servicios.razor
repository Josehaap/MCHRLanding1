@page "/servicios"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<body>
    <section class="que-hacemos">
        <div class="titulo-hacemos">
            <h2>@($"{contenidoNosotros[idiomaDetectado][0]}")</h2>
            <h3><strong>@($"{contenidoNosotros[idiomaDetectado][1]}")</strong></h3>
            <div class="linea"></div>
        </div>

        <article class="contenedor-cubos">
            @for(int i = 0; i < 3; i++)
            {
                <div class="tarjeta-cubo">
                    <div class="cubo"></div>
                    <img src='@($"{rutasImg[i]}")' alt="Imagen @i" />
                </div>
            }
        </article>
    </section>

    <!-- Sección de Servicios -->
    <section class="servicios-section">
        <h1 class="titulo">@($"{contenidoNosotros[idiomaDetectado][2]}")</h1>

        @for (int i = 0; i < 2; i++)
        {
            <div class="tarjeta">
                <div class="imagen">
                    <img src='@($"{rutasImg[i + 3]}")' alt="Imagen @i" />
                </div>
                <div class="contenido">
                    <h2>@contenidoNosotros[idiomaDetectado][i * 6 + 3]</h2>
                    <p>@contenidoNosotros[idiomaDetectado][i * 6 + 4]</p>
                    <ul>
                        @switch(i)
                        {
                            case 0:
                                @for (int j = 0; j < 4; j++)
                                {
                                    <li>@($"{contenidoNosotros[idiomaDetectado][i * 4 + 5 + j]}")</li>
                                }
                                break;
                            case 1:
                                @for (int j = 11; j < 14; j++)
                                {
                                    <li>@($"{contenidoNosotros[idiomaDetectado][j]}")</li>
                                }
                                break;
                        }
                        
                    </ul>
                </div>
            </div>
        }
        <div class="tarjeta">
            <div class="imagen">
                <img src="./img/SoftwareQA3.jpg" alt="Software QA">
            </div>
            <div class="contenido">
                <h2>@contenidoNosotros[idiomaDetectado][14]</h2>
                <p>@contenidoNosotros[idiomaDetectado][15]</p>
            </div>
        </div>
    </section>

    <!-- Sección de Métodos de Colaboración -->
    <section class="colaboracion-section">
        <h1 class="titulo">@contenidoNosotros[idiomaDetectado][16]</h1>
        <p class="subtitulo">@contenidoNosotros[idiomaDetectado][17]</p>

        <div class="colaboracion-grid">
            <div class="colaboracion-card">
                <div class="colaboracion-texto">
                    <h2>@contenidoNosotros[idiomaDetectado][18]</h2>
                    <p>@contenidoNosotros[idiomaDetectado][19]</p>
                </div>
                <div class="colaboracion-imagen">
                    <img src="./img/TeamWork2.jpg" alt="Outsourcing">
                </div>
            </div>

            <div class="colaboracion-card">
                <div class="colaboracion-imagen">
                    <img src="./img/TeamWork1.jpg" alt="Proyectos">
                </div>
                <div class="colaboracion-texto">
                    <h2>@contenidoNosotros[idiomaDetectado][20]</h2>
                    <p>@contenidoNosotros[idiomaDetectado][21]</p>
                </div>
            </div>
        </div>
    </section>

    <section class="porque-mindshore">
        <h1 class="titulo">@contenidoNosotros[idiomaDetectado][22]</h1>
        <div class="porque-cards">
            @for (int i = 0; i < 4; i++)
            {
                <div class='porque-card @(i==0 ? "border-highlight" : i==3 ? "highlight" : "")'>
                    <span class="porque-number">@($"{i + 1}")</span>
                    <h2>@contenidoNosotros[idiomaDetectado][i * 2 + 23]</h2>
                    <p>@contenidoNosotros[idiomaDetectado][i * 2 + 24]</p>
                    @if (i == 3)
                    {
                        <button class="btn" @onclick="NavigateToContact">@contenidoNosotros[idiomaDetectado][31]</button>
                    }
                </div>
            }
        </div>
    </section>

</body>



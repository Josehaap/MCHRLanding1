    private string idiomaDetectado = "es"; // Idioma detectado por el navegador
    protected override async Task OnInitializedAsync()
    {
        // Detectar el idioma del navegador
        idiomaDetectado = await JSRuntime.InvokeAsync<string>("getBrowserLanguage");
        idiomaDetectado = idiomaDetectado.Substring(0, 2); // Obtener solo el código del idioma (es, en, etc.)

        // Si el idioma no está en el diccionario, usar español como predeterminado
        if (!contenidoNosotros.ContainsKey(idiomaDetectado))
        {
            idiomaDetectado = "es";
        }
    }
    

@page "/nosotros"
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<ImagenSlash HayButton="false" NombreImg="reunionPersonas.jpg" Titulo='@($"{contenidoNosotros[idiomaDetectado][0]}")' Subtitulo="@($"{contenidoNosotros[idiomaDetectado][1]}")" />

<div class="options-container">
    <div class="options-container">
        @for (int i = 1; i < 4; i++)
        {
            var index = i; // Captura el valor de i en una variable local
            <div class="clickable-div @(selected == $"content{index}" ? "clickable-div-Active" : "")"
                @onclick='() => ShowOnly($"content{index}")'>
                <b>@($"{contenidoNosotros[idiomaDetectado][index + 1]}")</b>
            </div>
        }
    </div>
</div

@if (selected == "content1")
{
        <div class="content-div responsive-flex">
        <div class="text-content">
            <h3>@($"{contenidoNosotros[idiomaDetectado][5]}")</h3>
            @for (int i = 6; i < 9; i++)
            {
                <p>@($"{contenidoNosotros[idiomaDetectado][i]}")</p>
                <br />
            }
        </div>
        <div class="image-content hide-on-mobile">
            <img src="/img/CalleLarios.jpg" alt="Imagen relacionada" class="img-ajustada" />
        </div>
    </div>
}
else if (selected == "content2")
{
        <div class="content-div">
            <table style="width: 100%;text-align: center;">
                <tr>
                    @for (int i = 0; i < 3; i++)
                    {
                        <td style="width: 30%;">
                            <img src='@($"{listadoImagenes[i]}")' alt="Imagen relacionada" class="img-circular" />
                            <h3>@($"{contenidoNosotros[idiomaDetectado][9 + (i*2)]}")</h3>
                            <p>@($"{contenidoNosotros[idiomaDetectado][10 + (i * 2)]}")</p>
                        </td>
                    }
                </tr>
            </table>
        </div>
}
else if (selected == "content3")
{
        <div class="content-div">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%; padding-left: 10%; padding-right: 10%; ">
                        <img src="/img/NosotrosFotoFormulario.jpg" alt="Imagen relacionada"
                            style="max-width: 100%; border-radius: 8px;" />
                    </td>
                    <td style="wind: 45%;">
                        <div>
                            <h3 style="text-align: center;">@($"{contenidoNosotros[idiomaDetectado][15]}")</h3><br>
                            <ol>
                                @for (int i = 16; i < 22; i++)
                                {
                                    if (i == 18)
                                    {
                                        <ul>
                                            @for(; i < 20; i++)
                                            {
                                                <li>@($"{contenidoNosotros[idiomaDetectado][i]}")</li>
                                            }
                                           </ul>
                                    }
                                    
                                    <li>@($"{contenidoNosotros[idiomaDetectado][i]}")</li>
                                }
                            </ol>
                        </div>
                        
                        <div style="text-align: center;">
                            <button class="boton" id="botonContacto" @onclick='()=> NavigationManager.NavigateTo("/contacto")'>@($"{contenidoNosotros[idiomaDetectado][22]}")</button>
                        </div>

                    </td>
                </tr>
            </table>
        </div>


}

<section>
    @for (int i = 0; i < 3; i++)
    {
    <article>
        <img src='@($"{listadoImagenes[i + 3]}")' alt="Imagen relacionada" />  
        <div>
           <h3>@($"{contenidoNosotros[idiomaDetectado][ 2 * i + 23]}")</h3>
            <p>@($"{contenidoNosotros[idiomaDetectado][2 * i + 24]}")</p>
        </div>
        
    </article>
    }   
</section>


    <!-- Mapa -->
<div class="map-container">
    <img src="/img/mapa-removebg-preview.png" alt="Mapa" class="map-image">

    <div class="marker madrid">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Madrid</strong><br>
                C. de los Estudios
            </div>
        </div>
    </div>

    <div class="marker malaga">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Málaga</strong><br>
                Carretera Cádiz n°89
            </div>
        </div>
    </div>

    <div class="marker larioja">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>La Rioja</strong><br>
                Av. de la Tecnología 12
            </div>
        </div>
    </div>

    <div class="marker giblatar">
        <div class="tooltip-card">
            <div class="tooltip-content">
                <strong>Gibraltar</strong><br>
                Europa Point Rd
            </div>
        </div>
    </div>
</div>




<article class="llamadaDeAtencion">
    <ImagenSlash NombreImg="EmpresaImg.jpg"  Titulo='@($"{contenido[idiomaDetectado][18]}")' Subtitulo='@($"{contenido[idiomaDetectado][19]}")' TextColor="white" HayButton="false" />   
</article>

<section class="about">
        <h2>@($"{contenido[idiomaDetectado][20]}")</h2>
        <p>@($"{contenido[idiomaDetectado][21]}")</p>
        <div class="cards">
        @for (int i = 0; i < 3; i++)
        {
            <div class="card">
                <h3>@($"{contenido[idiomaDetectado][22 + i * 2]}")</h3>
                <p>@($"{contenido[idiomaDetectado][23 + i * 2]}")</p>
            </div>
        }
        </div>
</section>
<section class="precios">
    @* Índices base para cada plan en el array de contenido *@
    @{
        // Índices de inicio para cada plan en el contenido
        int[] indicesPlanes = new int[] { 28, 37, 49 };
        // Cantidad de características por plan
        int[] caracteristicasPorPlan = new int[] { 5, 8, 7 };
    }
    @for (int i = 0; i < 3; i++)
    {
        var idx = indicesPlanes[i];
        <div class="card-precio card-precios-@(i)" >
            <h3>@contenido[idiomaDetectado][idx]</h3>
            <p class="subtitulo1">@contenido[idiomaDetectado][idx + 1]</p>
            <h2>@contenido[idiomaDetectado][idx + 2]</h2>
            <p class="subtitulo2">@contenido[idiomaDetectado][idx + 3]</p>
            <ul>
                @for (int j = 0; j < caracteristicasPorPlan[i]; j++)
                {
                    <li>@contenido[idiomaDetectado][idx + 4 + j]</li>
                }
            </ul>
            @if (i == 1)
            {
                <div class="popular">Popular</div>
            }
            <button class="button" @onclick='()=> NavigationManager.NavigateTo("/contacto")'>Contacto</button>

        </div>
        
    }
</section>

<section class="testimonials">
    <div class="container">
        <div class="chat"></div>
        <h2>@($"{contenido[idiomaDetectado][61]}")</h2>
    </div>
    
    <article class="testimonials-contains">
        <div class="left-arrow arrow" @onclick="NavegarAtras"  ></div>
        <div class="testimonial">
            <p class="" >@($"{reseñas[contador][0]}")</p>
            <span> - @($"{reseñas[contador][1]}")</span>
        </div>
        <div class="right-arrow arrow" @onclick=" NavegarAdelante"></div>

    </article>
    
</section>

   


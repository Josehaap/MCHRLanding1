@page "/"
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
<PageTitle>Home</PageTitle>
 <div class="hero">
    <h1 style="width: @(idiomaDetectado == "es"? "29ch" : idiomaDetectado == "en"? "33ch": idiomaDetectado == "zh"? "20ch":"40ch");">@contenido[idiomaDetectado][0]</h1>
        <div class="hero-content">
            
            <p>@contenido[idiomaDetectado][1]</p> 
            <div class="button" @onclick='()=> NavigationManager.NavigateTo("/contacto")'>
                <Button ColoresFin="[]" ColoresInicio="[]" Textbutton='@($"{contenido[idiomaDetectado][2]}")' />
            </div>
        </div>

    
</div>
<section class="info">
        <h2>@($"{contenido[idiomaDetectado][3]}")</h2>
       <div>
            <h2>@($"{contenido[idiomaDetectado][4]}") </h2>
            <ul>
                @for (int i = 0; i < 2; i++)
                {
                    <li> @($"{contenido[idiomaDetectado][5 + i]}") </li>
                }
            </ul>
           
       </div>
       <div>
            <h2>@($"{contenido[idiomaDetectado][7]}")</h2>
            <ul>
                @for (int i = 0; i < 3; i++)
                {
                    <li> @($"{contenido[idiomaDetectado][8 + i]}") </li>
                }
                
            </ul>

       </div>
</section>

<section class="info2">
    @for (int i = 0; i < 5; i++)
    {   
        <article class=" info2-article@(i) " style="animation-delay: @(i + 1)s;" >
            <div class="@(GetClassName(i))"></div>
            <h4>@(contenido[idiomaDetectado][11 + i])</h4>
        </article>
    }
</section>
